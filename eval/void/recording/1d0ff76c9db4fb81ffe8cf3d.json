f}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .cs1-maint{color:#18911f}}</style><cite id=\\\"CITEREFSisson2016\\\" class=\\\"citation web cs1\\\">Sisson, Patrick (February 12, 2016). <a rel=\\\"nofollow\\\" class=\\\"external text\\\" href=\\\"https://web.archive.org/web/20201016115444/https://archive.curbed.com/2016/2/12/11029318/harry-gesner-architect-wave-house-sandcastle-house\\\">\\\"Harry Gesner – The Sandcastle House &amp; Wave House\\\"</a>. <i>Curbed</i>. Archived from <a rel=\\\"nofollow\\\" class=\\\"external text\\\" href=\\\"https://archive.curbed.com/2016/2/12/11029318/harry-gesner-architect-wave-house-sandcastle-house\\\">the original</a> on October 16, 2020<span class=\\\"reference-accessdate\\\">. Retrieved <span class=\\\"nowrap\\\">17 July</span> 2022</span>.</cite><span title=\\\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Curbed&amp;rft.atitle=Harry+Gesner+%E2%80%93+The+Sandcastle+House+%26+Wave+House&amp;rft.date=2016-02-12&amp;rft.aulast=Sisson&amp;rft.aufirst=Patrick&amp;rft&#95;id=https%3A%2F%2Farchive.curbed.com%2F2016%2F2%2F12%2F11029318%2Fharry-gesner-architect-wave-house-sandcastle-house&amp;rfr&#95;id=info%3Asid%2Fen.wikipedia.org%3AWave+House\\\" class=\\\"Z3988\\\"></span></span>\\n</li>\\n<li id=\\\"cite&#95;note-trd-2\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-trd_2-0\\\">^</a></b></span> <span class=\\\"reference-text\\\"><link rel=\\\"mw-deduplicated-inline-style\\\" href=\\\"mw-data:TemplateStyles:r1333433106\\\" /><cite class=\\\"citation news cs1\\\"><a rel=\\\"nofollow\\\" class=\\\"external text\\\" href=\\\"https://therealdeal.com/la/2022/06/19/iconic-los-angeles-area-architect-herry-gesner-dies-at-97/\\\">\\\"Iconic Los Angeles-area architect Herry Gesner dies at 97\\\"</a>. The Real Deal<span class=\\\"reference-accessdate\\\">. Retrieved <span class=\\\"nowrap\\\">12 July</span> 2022</span>.</cite><span title=\\\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.atitle=Iconic+Los+Angeles-area+architect+Herry+Gesner+dies+at+97&amp;rft&#95;id=https%3A%2F%2Ftherealdeal.com%2Fla%2F2022%2F06%2F19%2Ficonic-los-angeles-area-architect-herry-gesner-dies-at-97%2F&amp;rfr&#95;id=info%3Asid%2Fen.wikipedia.org%3AWave+House\\\" class=\\\"Z3988\\\"></span></span>\\n</li>\\n<li id=\\\"cite&#95;note-Germany646668-3\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-Germany646668_3-0\\\">^</a></b></span> <span class=\\\"reference-text\\\">Germany, pp. 64, 66, 68</span>\\n</li>\\n<li id=\\\"cite&#95;note-Germany5152-4\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-Germany5152_4-0\\\">^</a></b></span> <span class=\\\"reference-text\\\">Germany, pp. 51-52</span>\\n</li>\\n<li id=\\\"cite&#95;note-Germany6465-5\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-Germany6465_5-0\\\">^</a></b></span> <span class=\\\"reference-text\\\">Germany, pp. 64-65</span>\\n</li>\\n<li id=\\\"cite&#95;note-Germany73-6\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-Germany73_6-0\\\">^</a></b></span> <span class=\\\"reference-text\\\">Germany, p. 73</span>\\n</li>\\n<li id=\\\"cite&#95;note-Germany61-7\\\"><span class=\\\"mw-cite-backlink\\\"><b><a href=\\\"#cite_ref-Germany61_7-0\\\">^</a></b></span> <span class=\\\"reference-text\\\">Germany, p. 61</span>\\n</li>\\n<li id=\\\"cite&#95;note-latimes.com-8\\\"><span class=\\\"mw-cite-backlink\\\">^ <a href=\\\"#cite_ref-latimes.com_8-0\\\"><sup><i><b>a</b></i></sup></a> <a href=\\\"#cite_ref-latimes.com_8-1\\\"><sup><i><b>b</b></i></sup></a> <a href=\\\"#cite_ref-latimes.com_8-2\\\"><sup><i><b>c</b></i></sup></a></span> <span class=\\\"reference-text\\\">Jack Flemming (1 June 2023), <a rel=\\\"nofollow\\\" class=\\\"external text\\\" href=\\\"https://www.latimes.com/california/story/2023-